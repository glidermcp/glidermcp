{
  "mcpServers": {
    "glider": {
      "command": "dotnet",
      "args": [
        "tool",
        "exec",
        "glider@*",
        "--no-http-cache",
        "--verbosity",
        "quiet",
        "--",
        "--default-timeout",
        "30m"
      ]
    },
    "glider-trace": {
      "command": "dotnet",
      "args": [
        "tool",
        "exec",
        "glider-trace@*",
        "--no-http-cache",
        "--verbosity",
        "quiet",
        "--",
        "--default-timeout",
        "30m"
      ]
    },
    "tglider": {
      "command": "npx",
      "args": [
        "-y",
        "tglider@latest",
        "--default-timeout",
        "30m"
      ]
    },
    "scout": {
      "command": "npx",
      "args": [
        "-y",
        "@glidermcp/scout@latest"
      ]
    },
    "jglider": {
      "command": "npx",
      "args": [
        "-y",
        "--ignore-scripts",
        "jglider@next"
      ]
    }
  }
}
